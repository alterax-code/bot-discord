# Copier ce fichier en « .env » puis y coller le vrai jeton.
# Le fichier « .env » est exclu du dépôt par .gitignore — il ne partira jamais sur GitHub.
#
#   cp .env.example .env
#
# Le jeton se récupère sur https://discord.com/developers/applications
#   -> Grand Line RP -> Bot -> Reset Token
#
# Si ce jeton fuite un jour : le régénérer au même endroit suffit, l'ancien meurt aussitôt.

DISCORD_TOKEN=colle_ton_jeton_ici

# Niveau de détail des journaux : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Forcer les connexions en IPv4.
#
# À activer UNIQUEMENT sur une machine dont l'IPv6 est annoncée mais ne répond
# pas : la résolution DNS de Discord s'y bloque une dizaine de secondes avant
# d'abandonner. Or Discord détruit un jeton d'interaction au bout de 3 secondes
# — les boutons deviennent alors inutilisables, par intermittence.
#
# Inutile sur le VPS, qui répond en quelques millisecondes. Laisser vide en
# production.
FORCE_IPV4=

# Whitelist du serveur de jeu : le bot envoie au portail la liste des membres
# porteurs d'un rôle staff (voir [whitelist] dans config.toml). Ce secret est
# la MÊME valeur que PONT_BOT_SECRET dans le .env du portail. Vide = la
# whitelist n'est pas synchronisée, le reste du bot fonctionne.
#   openssl rand -hex 32
PORTAIL_SECRET=

# Pilotage du serveur de jeu par /serveur (voir [serveur] dans config.toml).
# Les quatre valeurs viennent de l'API mTxServ : la clé sur
# app.mtxserv.com/account/api, le couple client sur /account/oauth, et
# l'identifiant du serveur de jeu (pas celui de la facture). Ce sont les
# mêmes que /srv/grandline/mtxserv.env de la veille. Vide = la commande
# /serveur répond « pilotage non configuré », le reste du bot fonctionne.
MTXSERV_API_KEY=
MTXSERV_CLIENT_ID=
MTXSERV_CLIENT_SECRET=
MTXSERV_GAME_ID=
